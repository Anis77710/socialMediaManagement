NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_media_manager?schema=public
REDIS_URL=redis://localhost:6379

# ES256 keys, base64-encoded PEM. Generate with:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   base64 -w0 private.pem   -> JWT_PRIVATE_KEY
#   base64 -w0 public.pem    -> value inside JWT_PUBLIC_KEYS
JWT_PRIVATE_KEY=replace-with-base64-pkcs8-pem
JWT_PUBLIC_KEYS={"dev":"replace-with-base64-spki-pem"}
JWT_KID=dev
JWT_ACCESS_TTL_SEC=900
REFRESH_SLIDING_DAYS=30
REFRESH_ABSOLUTE_DAYS=180
MAX_ACTIVE_SESSIONS=10

OTP_PEPPER=replace-with-at-least-32-random-characters
OTP_TTL_SEC=300
AUTH_TIMING_FLOOR_MS=250
# OTP_DEV_BYPASS=123456

SMS_PROVIDER=console
SPARROW_URL=https://api.sparrowsms.com/v2/sms/
SPARROW_TOKEN=
SPARROW_FROM=
SMS_FALLBACK_URL=
SMS_FALLBACK_TOKEN=
SMS_FALLBACK_FROM=
SMS_DAILY_CAP=1000
SMS_ALERT_WEBHOOK_URL=
ALLOWED_COUNTRY_CODES=977

TURNSTILE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
CORS_ORIGINS=http://localhost:3001
TERMS_VERSION=2026-01
PRIVACY_VERSION=2026-01
ANDROID_SMS_HASH=

TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
BODY_LIMIT=1048576
SWAGGER_ENABLED=true

# Admin console (staff) auth. RUNTIME_ROLE=admin-api mounts /v1/admin only.
RUNTIME_ROLE=app-api
ADMIN_WEB_URL=http://localhost:3001
ADMIN_IP_ALLOWLIST=
ADMIN_SESSION_IDLE_MIN=30
ADMIN_SESSION_ABSOLUTE_HOURS=8
ADMIN_MAX_SESSIONS=3
ADMIN_SESSION_CACHE_SEC=30
ADMIN_STEP_UP_MIN=10
ADMIN_MFA_TOKEN_TTL_SEC=300
ADMIN_INVITE_TTL_HOURS=72
ADMIN_RESET_TTL_MIN=30
ADMIN_LOGIN_IP_LIMIT=20
ADMIN_LOGIN_IP_WINDOW_MIN=15
ADMIN_LOCKOUT_ALERT_THRESHOLD=3
TOTP_ISSUER=Redflie Admin
# PASSWORD_PEPPER=replace-with-at-least-32-random-characters
HIBP_CHECK_ENABLED=false
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# Optional key ring for encryption-at-rest. Defaults to {"v1": TOKEN_ENCRYPTION_KEY}.
# ENCRYPTION_KEYS={"v1":"replace-with-a-base64-encoded-32-byte-key"}
ACTIVE_ENCRYPTION_KID=v1
EMAIL_PROVIDER=console
EMAIL_FROM=Redflie <no-reply@redflie.local>
RESEND_API_KEY=
